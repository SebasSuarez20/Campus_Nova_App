# Copia este archivo a .env y cambia los valores. .env NO se sube al repositorio.

# Contrasena del usuario sa de SQL Server (minimo 8 caracteres, mayuscula, minuscula, numero y simbolo)
MSSQL_SA_PASSWORD=Cambia_Esta_Clave_123

# Clave para firmar los JWT (minimo 32 caracteres)
JWT_KEY=cambia-esta-clave-por-una-larga-y-aleatoria-de-32+

# Puerto publicado en el host
APP_PORT=8080

# Origenes permitidos por CORS (separados por coma). En la nube: https://tu-dominio.com
CORS_ORIGINS=http://localhost:8080
